{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "speedtest",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-17",
  // OpenNext runs the Next.js server on workerd; Prisma, pg and the rest of
  // the Node surface need this flag. Without it the Worker fails at import.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Postgres is reached through Hyperdrive, not directly. Supabase's pooler
  // serves a self-signed chain (Supabase Intermediate 2021 CA) and workerd's
  // connect() always verifies against the public CA store with no way to opt
  // out, so pg's TLS upgrade died as "Connection terminated unexpectedly".
  // Hyperdrive terminates TLS at the edge (config created with sslmode=require)
  // and pools origin connections. The connection string arrives on the binding;
  // no credentials live in this file.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d0bca06840eb4156a5cde349dc6926a6"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "speedtest"
    }
  ],
  // Every request in this app does several Postgres round trips, so the Worker
  // wants to run next to the database, not next to the student. Smart placement
  // moves the invocation to the colo closest to the Hyperdrive origin after it
  // has observed enough traffic - worth several hundred ms per exam action when
  // a cohort is sitting far from the Supabase region.
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  }
}
