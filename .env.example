# Database - Supabase via the Supavisor pooler.
# db.<ref>.supabase.co is IPv6-only, so always use the pooler host for both URLs.
# Percent-encode any @ / : ? # ! in the password.
# 6543 = transaction mode (app runtime), 5432 = session mode (prisma migrate DDL).
# These drive next dev, prisma migrate, the seed script and the deployment on
# Render. No sslmode here - the runtime connection is verified against
# DATABASE_CA_CERT_B64 below (verify-full), configured in src/lib/db.ts.
# db.ts also carries a dormant workerd/Hyperdrive branch from an earlier
# Cloudflare target. Nothing deploys there now and it is inert on Node, so
# these two URLs are the only connection the app uses.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Base64 of the "Supabase Root 2021 CA" PEM - the self-signed root of Supabase's
# certificate chain, which is not in any public trust store. db.ts pins it so the
# pooler connection is verified, not blindly trusted. It is a public value, not a
# secret. Get it from your Supabase project (Settings > Database > SSL) or from
# the live chain:
#   printf '' | openssl s_client -starttls postgres -showcerts \
#     -connect aws-0-<region>.pooler.supabase.com:6543 2>/dev/null \
#     | awk 'BEGIN{c=0} /BEGIN CERT/{c++} c==3{print} c==3 && /END CERT/{exit}' \
#     | base64 -w0
DATABASE_CA_CERT_B64=""

# NextAuth
# In production (Render) NEXTAUTH_URL must be the public https origin, e.g.
# https://speedtest-45s1.onrender.com - not localhost - or auth callbacks break.
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Email - Brevo HTTPS API (src/lib/email.ts).
# We use the HTTP API, not SMTP: Render's free tier blocks outbound SMTP
# ports (25/465/587), so nodemailer/SMTP times out there. The API is on 443.
# BREVO_API_KEY: a v3 key from Brevo > SMTP & API > API Keys (format xkeysib-...).
# EMAIL_FROM: must be a sender verified in Brevo (Senders & IP > Senders).
#   Single-sender verification (click a link) is enough - no domain/DNS needed.
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="ankur.yadav@speedinnovations.in"


# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_COMPANY_NAME="Speed Innovation"
