# Database - Supabase via the Supavisor pooler.
# db.<ref>.supabase.co is IPv6-only, so always use the pooler host for both URLs.
# Percent-encode any @ / : ? # ! in the password.
# 6543 = transaction mode (app runtime), 5432 = session mode (prisma migrate DDL).
# These drive Node only: next dev, prisma migrate, the seed script and the
# Node deployment (Render). No sslmode here - the app's runtime connection is
# verified against DATABASE_CA_CERT_B64 below (verify-full), configured in
# src/lib/db.ts. On Cloudflare the app reaches Postgres through the HYPERDRIVE
# binding instead - workerd's connect() always verifies TLS against the public
# CA store, and Supabase serves a self-signed chain, so a direct pg connection
# cannot work there; Hyperdrive terminates origin TLS on its behalf.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Base64 of the "Supabase Root 2021 CA" PEM - the self-signed root of Supabase's
# certificate chain, which is not in any public trust store. db.ts pins it so the
# pooler connection is verified, not blindly trusted. It is a public value, not a
# secret. Get it from your Supabase project (Settings > Database > SSL) or from
# the live chain:
#   printf '' | openssl s_client -starttls postgres -showcerts \
#     -connect aws-0-<region>.pooler.supabase.com:6543 2>/dev/null \
#     | awk 'BEGIN{c=0} /BEGIN CERT/{c++} c==3{print} c==3 && /END CERT/{exit}' \
#     | base64 -w0
DATABASE_CA_CERT_B64=""

# NextAuth
# In production (Render) NEXTAUTH_URL must be the public https origin, e.g.
# https://speedtest-45s1.onrender.com - not localhost - or auth callbacks break.
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Email (SMTP) - Use Gmail App Password or SendGrid
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@speedinnovation.com"

# File Storage - Vercel Blob
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="Speed Innovation"

# Cloudflare deploy/preview only. wrangler needs a Postgres URL to stand the
# HYPERDRIVE binding up locally; the deployed Worker uses the Hyperdrive config
# (id in wrangler.jsonc) and never reads this. Export it before `npm run cf:deploy`:
#   export CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="$DATABASE_URL"
